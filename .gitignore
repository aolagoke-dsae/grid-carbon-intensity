# secrets
.env
*.env
*token*.txt
*token*.json
entsoe_token.txt

# raw payloads are large and reproducible; the manifest is the provenance
# record and MUST be committed. git will not descend into an ignored
# directory, so the contents are ignored rather than the directory itself.
raw/*
!raw/manifest.csv

# curated Parquet: ignore the full backfill. curated/sample/ is the
# exception: the synthetic sample, since ENTSO-E's terms do not open A75 or
# A44 for re-use (README, Licence), so that `dbt build --target sample` works
# on a clone with no ENTSO-E token.
curated/*
!curated/sample/

# notebooks: exploration only. Outputs can embed a token printed by a cell,
# which .env protection does not cover. Clear outputs before committing.
.ipynb_checkpoints/
notebooks/scratch/

# editor settings: personal, not part of the project. Added 19.10.2026 before
# the repository went public, so `git add -A` cannot publish them.
.vscode/

# build artefacts
__pycache__/
*.pyc
.venv/
warehouse/*.duckdb
target/
dbt_packages/
.user.yml
dbt/profiles.yml
logs/

# Power BI file, committed deliberately: it is built on the exported Parquet.
# (Until 17.10.2026 this said "at Stage 6b", the dropped Azure excursion.)
!*.pbix
